# Cloudflare Pages headers for avataragency.ai
# The Thriving Project staging film: 472 numbered frames + hi-res anchors.
# They are content-stable (re-cut frames go in a new folder), so cache them
# hard — the scrub engine re-reads them on every visit otherwise.
/thrivingincollege/assets/frames/*
  Cache-Control: public, max-age=31536000, immutable
/thrivingincollege/assets/hires/*
  Cache-Control: public, max-age=31536000, immutable
/thrivingincollege/assets/*
  Cache-Control: public, max-age=604800
