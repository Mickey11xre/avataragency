# Cloudflare Pages headers for avataragency.ai
# Rules are applied in order and later rules win for the same header, so the
# broad /assets/* rule comes FIRST and the immutable film rules override it.
# The Thriving Project staging film: 472 numbered frames + hi-res anchors are
# content-stable (a re-cut goes in a new folder), so they cache for a year.
/thrivingincollege/assets/*
  Cache-Control: public, max-age=604800
/thrivingincollege/assets/frames/*
  Cache-Control: public, max-age=31536000, immutable
/thrivingincollege/assets/hires/*
  Cache-Control: public, max-age=31536000, immutable
